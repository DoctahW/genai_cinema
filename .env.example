# Chave do OpenRouter (https://openrouter.ai/keys). Obrigatória.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos em ordem de preferência, separados por vírgula (FallbackModel).
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Banco Gold (SQLite). Baixe e descompacte em data/cinerocket.db.
DB_PATH=data/cinerocket.db
SQL_TIMEOUT_S=10
SQL_MAX_ROWS=200

# Teto de chamadas ao LLM por pergunta.
AGENT_REQUEST_LIMIT=4

# Cache de respostas
CACHE_PATH=.cache/answers.db
CACHE_TTL_S=86400

LOG_LEVEL=INFO
